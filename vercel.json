{
  "buildCommand": "npm --prefix apps/web run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/whatsapp-webhook",
      "destination": "/api/whatsapp-webhook.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
