{
    "name": "@svv-ams/api",
    "version": "1.0.0",
    "engines": {
        "node": ">=20"
    },
    "private": true,
    "scripts": {
        "dev": "tsx watch src/app.ts",
        "build": "tsc",
        "start": "node dist/app.js",
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate dev --name init",
        "db:migrate:prod": "prisma migrate deploy",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio",
        "db:reset": "prisma migrate reset --force",
        "test": "vitest run"
    },
    "dependencies": {
        "@prisma/client": "^5.16.0",
        "@supabase/supabase-js": "2.44.4",
        "@whiskeysockets/baileys": "^7.0.0-rc14",
        "bcryptjs": "^2.4.3",
        "bullmq": "^5.10.0",
        "compression": "^1.7.4",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.3.1",
        "helmet": "^7.1.0",
        "ioredis": "^5.4.1",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^6.9.14",
        "pino": "^10.3.1",
        "prisma": "^5.16.0",
        "qrcode": "^1.5.4",
        "typescript": "^5.5.2",
        "uuid": "^10.0.0",
        "winston": "^3.13.0",
        "ws": "^8.18.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.6",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.14.0",
        "@types/nodemailer": "^6.4.15",
        "@types/qrcode": "^1.5.5",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.5.10",
        "prisma": "^5.16.0",
        "tsx": "^4.16.0",
        "vitest": "^1.6.0"
    }
}
